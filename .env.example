# A PWA publica nao precisa de senha nem banco de servidor.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Apenas para analise geral voluntaria (nao armazena o diario pessoal):
# COMMUNITY_ENABLED=true
# DB_HOST=HOST_MYSQL_DO_PAINEL
# DB_PORT=3306
# DB_NAME=NOME_COMPLETO_DO_BANCO
# DB_USER=USUARIO_COMPLETO_DO_BANCO
# DB_PASSWORD=CONFIGURE_A_SENHA_NOVA_NO_PAINEL
# Lembretes: DATA_DIR privado persistente e detectado na estrutura hbuilds.
# PUSH_ENABLED=false
# PUSH_SUBJECT=https://entredias.online/
# Apenas para exportar uma instalacao SQLite anterior, opcional e temporario:
# ENABLE_LEGACY_EXPORT=true
# APP_PASSWORD=DEFINA_UMA_SENHA_NOVA_COM_PELO_MENOS_12_CARACTERES
# DATA_DIR=/home/SEU_USUARIO/domains/SEU_DOMINIO/entredias-data
